# ===========================================
# レシートスキャナー 環境設定
# ===========================================

# Google Cloud Vision API
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_WORKSHEET_NAME=レシート

# Google OAuth2 (for Sheets access)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# MoneyForward ME
MONEYFORWARD_EMAIL=your_email@example.com
MONEYFORWARD_PASSWORD=your_password_here

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=your-secret-key-change-this
UPLOAD_DIR=uploads
EXPORT_DIR=exports
